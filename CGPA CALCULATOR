#include <iostream>
#include <iomanip>
#include <string>
using namespace std;

// Function to convert grade into grade point
double getGradePoint(string grade)
{
    if (grade == "A+" || grade == "a+")
        return 10.0;
    else if (grade == "A" || grade == "a")
        return 9.0;
    else if (grade == "B+" || grade == "b+")
        return 8.0;
    else if (grade == "B" || grade == "b")
        return 7.0;
    else if (grade == "C+" || grade == "c+")
        return 6.0;
    else if (grade == "C" || grade == "c")
        return 5.0;
    else if (grade == "D" || grade == "d")
        return 4.0;
    else
        return 0.0;
}

int main()
{
    int n;

    cout << "========================================\n";
    cout << "          CGPA CALCULATOR\n";
    cout << "========================================\n";

    cout << "Enter the number of courses: ";
    cin >> n;

    string courseName[n];
    string grade[n];
    int credit[n];
    double gradePoint[n];
    double courseGradePoint[n];

    double totalCredits = 0;
    double totalGradePoints = 0;

    // Input course details
    for (int i = 0; i < n; i++)
    {
        cout << "\nEnter details for Course " << i + 1 << endl;

        cout << "Course Name: ";
        cin >> courseName[i];

        cout << "Credits: ";
        cin >> credit[i];

        cout << "Grade (A+, A, B+, B, C+, C, D, F): ";
        cin >> grade[i];

        gradePoint[i] = getGradePoint(grade[i]);

        // Calculate weighted grade points
        courseGradePoint[i] = credit[i] * gradePoint[i];

        totalCredits += credit[i];
        totalGradePoints += courseGradePoint[i];
    }

    // Calculate CGPA
    double cgpa = totalGradePoints / totalCredits;

    // Display result
    cout << "\n\n========================================\n";
    cout << "             COURSE DETAILS\n";
    cout << "========================================\n";

    cout << left << setw(15) << "Course"
         << setw(10) << "Credits"
         << setw(10) << "Grade"
         << setw(15) << "Grade Point" << endl;

    cout << "----------------------------------------\n";

    for (int i = 0; i < n; i++)
    {
        cout << left << setw(15) << courseName[i]
             << setw(10) << credit[i]
             << setw(10) << grade[i]
             << setw(15) << gradePoint[i] << endl;
    }

    cout << "========================================\n";
    cout << fixed << setprecision(2);

    cout << "Total Credits       : " << totalCredits << endl;
    cout << "Total Grade Points  : " << totalGradePoints << endl;
    cout << "Semester CGPA       : " << cgpa << endl;

    cout << "========================================\n";

    return 0;
}
